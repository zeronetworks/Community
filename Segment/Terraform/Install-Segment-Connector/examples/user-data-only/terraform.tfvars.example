# Copy this file to terraform.tfvars and fill in the values.
# Do not put the token here. Set it with: export TF_VAR_token='<token>'
# WARNING: the token ends up in the instance's user data. See README.md.

region        = "us-east-1"
instance_name = "connector-userdata-test"
instance_type = "t3.micro"

# A link the instance can download the zip from, without a login. Pre-signed URL, https only.
installer_url = "https://example-bucket.s3.amazonaws.com/segment-connector-linux-installer-X.Y.Z.W.zip?X-Amz-Expires=3600&..."

# Enrollment. A new instance is not in the portal yet.
allow_create   = true
asset_fqdn     = ""
asset_name     = "connector-userdata-test"
with_static_ip = false

run_as = "zn-user"
