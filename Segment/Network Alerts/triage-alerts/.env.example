# Zero Networks portal base URL (no trailing slash, no /api/v1 suffix -
# the script appends /api/v1 automatically).
# Example: https://<your-org>-admin.zeronetworks.com
ZN_API_BASE_URL=https://your-org-admin.zeronetworks.com

# Zero Networks API key. Sent verbatim in the "Authorization" header.
ZN_API_KEY=your_api_key_here
