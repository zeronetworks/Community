{
  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/managementGroupDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Assigns the built-in initiative 'Enable allLogs category group resource logging for supported resources to storage' (b6b86da9-e527-49de-ac59-6af0a9db10b8) at the target management group for one region, with a system-assigned identity and the Log Analytics Contributor role the member definitions declare. Remediation tasks are not created by this template: for management group assignments, Azure Policy creates them only after the first compliance evaluation. See the README."
  },
  "parameters": {
    "storageAccountId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the log storage account the logs are written to. Example: /subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/znccweu"
      }
    },
    "resourceLocation": {
      "type": "string",
      "metadata": {
        "description": "Region of the resources to cover. Must be the region of the log storage account. Assign once per region.",
        "strongType": "location"
      }
    },
    "resourceTypeList": {
      "type": "array",
      "defaultValue": [
        "microsoft.dbformysql/flexibleservers",
        "microsoft.dbforpostgresql/flexibleservers",
        "microsoft.keyvault/vaults",
        "microsoft.eventhub/namespaces",
        "microsoft.servicebus/namespaces"
      ],
      "metadata": {
        "description": "Resource types to enable allLogs logging for, as lowercase type names from the initiative's allowed list. Defaults to the types the Zero Networks Azure Connector reads."
      }
    },
    "diagnosticSettingName": {
      "type": "string",
      "defaultValue": "setByPolicy-Storage",
      "metadata": {
        "description": "Name of the diagnostic setting the policy creates on each resource."
      }
    },
    "effect": {
      "type": "string",
      "defaultValue": "DeployIfNotExists",
      "allowedValues": [
        "DeployIfNotExists",
        "AuditIfNotExists",
        "Disabled"
      ],
      "metadata": {
        "description": "Policy effect. DeployIfNotExists creates the diagnostic settings; AuditIfNotExists only reports."
      }
    },
    "assignmentName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 24,
      "metadata": {
        "description": "Policy assignment name. Leave empty to use zn-logs-<resourceLocation> (trimmed to 24 characters, the management group limit)."
      }
    },
    "grantRoleOnStorageAccount": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Also grant the assignment's managed identity Log Analytics Contributor on the log storage account. Needed when the storage account is outside the assignment scope."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[deployment().location]",
      "metadata": {
        "description": "Region that holds the policy assignment's managed identity metadata. Defaults to the deployment region."
      }
    }
  },
  "variables": {
    "grantRoles": "[equals(parameters('effect'), 'DeployIfNotExists')]",
    "assignmentName": "[if(empty(parameters('assignmentName')), take(format('zn-logs-{0}', parameters('resourceLocation')), 24), parameters('assignmentName'))]",
    "policySetDefinitionId": "[tenantResourceId('Microsoft.Authorization/policySetDefinitions', 'b6b86da9-e527-49de-ac59-6af0a9db10b8')]"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/policyAssignments",
      "apiVersion": "2025-03-01",
      "name": "[variables('assignmentName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "displayName": "[format('Zero Networks Azure Connector: allLogs to storage ({0})', parameters('resourceLocation'))]",
        "description": "Enable allLogs category group resource logging to the Zero Networks Azure Connector log storage account.",
        "policyDefinitionId": "[variables('policySetDefinitionId')]",
        "parameters": {
          "storageAccount": {
            "value": "[parameters('storageAccountId')]"
          },
          "resourceLocation": {
            "value": "[parameters('resourceLocation')]"
          },
          "resourceTypeList": {
            "value": "[parameters('resourceTypeList')]"
          },
          "diagnosticSettingName": {
            "value": "[parameters('diagnosticSettingName')]"
          },
          "effect": {
            "value": "[parameters('effect')]"
          }
        }
      }
    },
    {
      "comments": "Log Analytics Contributor (the role the policy definitions declare) for the assignment's identity at the assignment scope. Only DeployIfNotExists needs it.",
      "condition": "[variables('grantRoles')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(managementGroup().id, variables('assignmentName'), '92aaf0da-9dab-42b6-94a3-d43ce8d16293')]",
      "properties": {
        "roleDefinitionId": "[tenantResourceId('Microsoft.Authorization/roleDefinitions', '92aaf0da-9dab-42b6-94a3-d43ce8d16293')]",
        "principalId": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', variables('assignmentName')), '2025-03-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "description": "Zero Networks Azure Connector logging policy remediation"
      },
      "dependsOn": [
        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', variables('assignmentName'))]"
      ]
    },
    {
      "comments": "Same role on the log storage account, deployed into the account's own subscription and resource group.",
      "condition": "[and(parameters('grantRoleOnStorageAccount'), variables('grantRoles'))]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[take(format('{0}-storage-role', variables('assignmentName')), 64)]",
      "subscriptionId": "[split(parameters('storageAccountId'), '/')[2]]",
      "resourceGroup": "[split(parameters('storageAccountId'), '/')[4]]",
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "storageAccountName": {
            "value": "[last(split(parameters('storageAccountId'), '/'))]"
          },
          "principalId": {
            "value": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', variables('assignmentName')), '2025-03-01', 'full').identity.principalId]"
          },
          "roleDefinitionGuid": {
            "value": "92aaf0da-9dab-42b6-94a3-d43ce8d16293"
          },
          "roleDescription": {
            "value": "Zero Networks Azure Connector logging policy remediation"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "storageAccountName": {
              "type": "string"
            },
            "principalId": {
              "type": "string"
            },
            "roleDefinitionGuid": {
              "type": "string"
            },
            "roleDescription": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.Storage/storageAccounts/{0}', parameters('storageAccountName'))]",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('principalId'), parameters('roleDefinitionGuid'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionGuid'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal",
                "description": "[parameters('roleDescription')]"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', variables('assignmentName'))]"
      ]
    }
  ],
  "outputs": {
    "policyAssignmentId": {
      "type": "string",
      "value": "[extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', variables('assignmentName'))]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(managementGroup().id, 'Microsoft.Authorization/policyAssignments', variables('assignmentName')), '2025-03-01', 'full').identity.principalId]"
    }
  }
}
